---
import { defaultLang } from '../config/site';
const target = `/${defaultLang}/`;
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <title>T2M — Transit M. Meharzi</title>
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <meta name="robots" content="noindex" />
    <script is:inline define:vars={{ target }}>
      location.replace(navigator.language?.startsWith('ar') ? '/ar/' : target);
    </script>
  </head>
  <body><a href={target}>{target}</a></body>
</html>
