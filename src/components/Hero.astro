---
import Icon from './Icon.astro';
import { img, srcset, t, type Lang } from '../config/site';

interface Props {
  lang: Lang;
}
const d = t(Astro.props.lang).hero;
---

<section class="on-dark relative isolate flex min-h-[600px] items-center overflow-hidden bg-night text-white lg:min-h-[calc(100svh-5rem)] lg:max-h-[860px]">
  <img
    src={img('hero', 1600)}
    srcset={srcset('hero', [800, 1200, 1600, 2400])}
    sizes="100vw"
    alt=""
    fetchpriority="high"
    class="absolute inset-0 -z-20 size-full object-cover"
  />
  <div
    class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgba(7,18,64,0.92)_0%,rgba(7,18,64,0.7)_45%,rgba(7,18,64,0.15)_100%)] rtl:bg-[linear-gradient(270deg,rgba(7,18,64,0.92)_0%,rgba(7,18,64,0.7)_45%,rgba(7,18,64,0.15)_100%)]"
  >
  </div>

  <div class="mx-auto w-full max-w-7xl px-5 pb-36 pt-20 lg:px-8 lg:pb-44">
    <div class="max-w-2xl">
      <p class="eyebrow text-lime">{d.kicker}</p>
      <h1 class="mt-6 text-[3.4rem] font-bold leading-[0.92] !text-white sm:text-7xl lg:text-[6.5rem] rtl:leading-[1.15]">
        {d.tagline}
      </h1>
      <p class="mt-7 max-w-lg text-lg leading-relaxed text-white/85 sm:text-xl">{d.subtitle}</p>
      <div class="mt-10 flex flex-wrap gap-4">
        <a href="#contact" class="btn-primary">
          {d.cta}
          <Icon name="arrow" class="size-4 rtl:-scale-x-100" />
        </a>
        <a href="#services" class="btn-ghost">{d.secondary}</a>
      </div>
    </div>
  </div>
</section>
