---
import { t, type Lang } from '../config/site';

interface Props {
  lang: Lang;
}
const items = t(Astro.props.lang).trust;
---

<div class="relative z-10 mx-auto -mt-20 max-w-7xl px-5 lg:-mt-24 lg:px-8">
  <ul class="grid grid-cols-2 bg-white shadow-[0_24px_50px_-24px_rgba(7,18,64,0.35)] lg:grid-cols-4">
    {
      items.map((item, i) => (
        <li
          class:list={[
            'border-line px-5 py-6 sm:px-8 sm:py-8',
            i % 2 === 0 && 'border-e',
            i < 2 && 'border-b lg:border-b-0',
            i === 1 && 'lg:border-e',
            i === 0 && 'border-t-4 border-t-lime',
            'lg:border-t-4 lg:border-t-transparent lg:first:border-t-lime',
          ]}
        >
          <p class="font-display text-xl font-bold leading-tight text-ink">{item.title}</p>
          <p class="mt-1 text-[15px] text-muted">{item.text}</p>
        </li>
      ))
    }
  </ul>
</div>
