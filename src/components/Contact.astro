---
import Icon from './Icon.astro';
import { site, t, type Lang } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const dict = t(lang);
const d = dict.contact;
const f = d.form;
const waHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(d.whatsappMessage)}`;

const field =
  'mt-2 block w-full border border-line bg-white px-4 py-3.5 text-[16px] font-normal text-ink transition-colors placeholder:text-muted/70 hover:border-muted/50 focus:border-brand focus:outline-none focus:ring-1 focus:ring-brand';
const label = 'block text-sm font-semibold text-ink';
---

<section id="contact" class="bg-white pb-24 pt-8 lg:pb-32">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-8">
      <!-- Form -->
      <div class="lg:col-span-7">
        <p class="eyebrow text-brand">{d.eyebrow}</p>
        <h2 class="mt-5 text-4xl font-bold leading-[1.02] sm:text-5xl">{d.title}</h2>
        <p class="mt-5 text-lg">{d.subtitle}</p>

        <form
          id="quote-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="mt-10"
          data-sending={f.sending}
          data-success={f.success}
          data-error={f.error}
        >
          <input type="hidden" name="access_key" value={site.web3formsKey} />
          <input type="hidden" name="subject" value={f.subject} />
          <input type="hidden" name="from_name" value={`${site.name} — ${site.fullName}`} />
          <input type="hidden" name="language" value={lang} />
          <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />

          <div class="grid gap-x-5 gap-y-6 sm:grid-cols-2">
            <label class={label}>
              {f.name} <span class="text-brand">*</span>
              <input name="name" required autocomplete="name" class={field} />
            </label>
            <label class={label}>
              {f.company}
              <input name="company" autocomplete="organization" class={field} />
            </label>
            <label class={label}>
              {f.phone} <span class="text-brand">*</span>
              <input type="tel" name="phone" required autocomplete="tel" dir="ltr" class:list={[field, 'rtl:text-end']} />
            </label>
            <label class={label}>
              {f.email}
              <input type="email" name="email" autocomplete="email" dir="ltr" class:list={[field, 'rtl:text-end']} />
            </label>
            <label class:list={[label, 'sm:col-span-2']}>
              {f.service} <span class="text-brand">*</span>
              <select name="service" required class={field}>
                <option value="" disabled selected>{f.servicePlaceholder}</option>
                {dict.services.items.map((s) => <option value={s.title}>{s.title}</option>)}
              </select>
            </label>
            <label class:list={[label, 'sm:col-span-2']}>
              {f.message} <span class="text-brand">*</span>
              <textarea name="message" rows="5" required placeholder={f.messageHint} class={field}></textarea>
            </label>
          </div>

          <button type="submit" class="btn-primary mt-8 w-full disabled:opacity-60 sm:w-auto">
            <span data-label>{f.submit}</span>
            <Icon name="arrow" class="size-4 rtl:-scale-x-100" />
          </button>
          <p id="form-status" class="mt-5 hidden px-4 py-3 text-sm font-medium" role="status" aria-live="polite"></p>
        </form>
      </div>

      <!-- Details -->
      <aside class="lg:col-span-4 lg:col-start-9">
        <div class="on-dark bg-navy p-8 text-white/75 lg:sticky lg:top-28 lg:p-10">
          <h3 class="text-2xl font-bold !text-white">{d.details}</h3>
          <dl class="mt-8 space-y-6">
            <div>
              <dt class="text-sm text-white/60">{d.phone}</dt>
              <dd><a href={`tel:${site.phoneLink}`} class="font-display text-2xl font-bold text-white hover:text-lime" dir="ltr">{site.phoneDisplay}</a></dd>
            </div>
            <div>
              <dt class="text-sm text-white/60">{d.email}</dt>
              <dd><a href={`mailto:${site.email}`} class="break-all font-semibold text-white hover:text-lime">{site.email}</a></dd>
            </div>
            <div>
              <dt class="text-sm text-white/60">{d.address}</dt>
              <dd class="font-semibold text-white">{dict.address}</dd>
            </div>
            <div>
              <dt class="text-sm text-white/60">{d.hours}</dt>
              <dd class="font-semibold text-white">{dict.hours}</dd>
            </div>
          </dl>
          <a href={waHref} target="_blank" rel="noopener" class="btn mt-9 w-full bg-[#25D366] text-night hover:bg-[#3ae07a]">
            <Icon name="whatsapp" class="size-5" />
            {d.whatsapp}
          </a>
        </div>
      </aside>
    </div>
  </div>

  <!-- Map -->
  <div class="mx-auto mt-20 max-w-7xl px-5 lg:px-8">
    <div class="relative bg-paper">
      <iframe
        src={site.mapEmbedUrl}
        title={d.mapTitle}
        class="block h-80 w-full grayscale-[35%] sm:h-[420px]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen></iframe>
      <a
        href={site.mapLink}
        target="_blank"
        rel="noopener"
        class="btn absolute bottom-5 start-5 bg-white text-sm text-ink shadow-lg hover:text-brand"
      >
        <Icon name="map" class="size-4" />
        {d.openMap}
      </a>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const label = btn.querySelector('[data-label]')!;
    const original = label.textContent;
    const show = (msg: string, ok: boolean) => {
      if (!status) return;
      status.textContent = msg;
      status.className = `mt-5 border-s-4 px-4 py-3 text-sm font-medium ${ok ? 'border-lime bg-paper text-ink' : 'border-red-600 bg-red-50 text-red-700'}`;
    };

    btn.disabled = true;
    label.textContent = form.dataset.sending ?? '';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const json = await res.json();
      if (!res.ok || !json.success) throw new Error(json.message);
      show(form.dataset.success ?? '', true);
      form.reset();
    } catch {
      show(form.dataset.error ?? '', false);
    } finally {
      btn.disabled = false;
      label.textContent = original;
    }
  });
</script>
